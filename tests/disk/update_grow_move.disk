# 把一行撑大到本页装不下 —— 它必须搬到别的页去。
#
# 危险点：旧位置留下墓碑，新位置在另一页。扫描时既不能漏，也不能重复。
# 而且那 400 字节的内容必须一个字节都不差地跟过去。
#
# 算术：
#   60 行 x 92 字节 = 5520，一页装 44 行
#   所以堆链是：页 1（44 行，剩 36 字节）
#             -> 页 3（16 行，剩 2612 字节）
#   （页 2 是目录页 —— createTable 先分配堆页，再往目录里记一笔）
#   撑大后的行 cell = 400+14 = 414，加槽位 4 = 418
#     页 1 腾出旧行之后也只有 36+88 = 124 < 418
#                                            -> 装不下，必须搬
#     页 3 有 2612 >= 418  -> 搬得进去，不用再开新页
#   所以 !pages 应该一直是 4

-d|test.db|-e|CREATE TABLE m (id INT, s TEXT);
!bulk m|60|74
!pages 4

-d|test.db|-e|UPDATE m SET s = '' WHERE id = 25;
!pages 4

# 一行都不能少，一行都不能重
-d|test.db|-e|SELECT COUNT(*), SUM(id) FROM m;
-d|test.db|-e|SELECT COUNT(*) FROM m WHERE s = '';
-d|test.db|-e|SELECT COUNT(*) FROM m WHERE s = 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx';

# 抽查搬家行的前后邻居，看墓碑有没有把链子弄断
-d|test.db|-e|SELECT id FROM m WHERE id <= 3 OR id >= 58 ORDER BY id;

# 关掉再打开：搬过去的行必须在
-d|test.db|-e|SELECT COUNT(*) FROM m WHERE s = '';
-d|test.db|-e|SELECT id FROM m WHERE s = '';
