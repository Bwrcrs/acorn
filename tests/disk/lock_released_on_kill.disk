# 阶段 6：**进程被强杀之后，锁立刻就能用。**
#
# ★ 这是整个阶段 6 最值钱的一个用例 ★
#
# 它证明的是"为什么锁必须是操作系统给的文件锁，而不是自己写一个
# .lock 文件记进程号"：
#
#   自己写 .lock 文件的话，这个被强杀的进程**没机会去删它**
#   （TerminateProcess 不跑任何析构、不刷任何缓冲）。于是那个
#   文件变成一个僵尸锁：库里明明没人在用，后来的人却谁也进不去。
#   要修就得判断"那个进程号还活着吗"——而 Windows 会把进程号
#   回收再分配，一个早就死掉的号可能已经属于别人了。判断错了
#   就是两个写者，回到原点，还多了一层"它看起来是好的"。
#
#   操作系统的文件锁没有这个问题：**放锁是内核做的**。
#   进程一消失（不管怎么消失的），它持有的锁全部立刻释放。
#
# 这个用例走的正是那条路：!killbg 就是 TerminateProcess，
# 和任务管理器里点"结束任务"、和拔电源是同一件事。

-d|test.db|-e|CREATE TABLE t (id INT, v TEXT); INSERT INTO t VALUES (1,'one');

# ---- 后台：开事务、写一行、然后一直不提交（8 秒，够我们杀它）----
!bg 8000|BEGIN; INSERT INTO t VALUES (2,'doomed');

# ---- 这时候它独占着库，谁也进不来 ----
# 退出码 2：这不是 SQL 的问题，是"现在库归别人"。
# （同一个数在"等到超时"那种情况下也是 2，理由见 lock_wait.disk。）
-d|test.db|-e|SELECT * FROM t;

# ---- 杀掉它。不打招呼，不给它机会收拾 ----
!killbg

# ---- 下一条命令**立刻**就能用，中间不用等任何东西 ----
#
# 它还会顺带做另一件事：那个被杀的进程留下了一份回滚日志
# （它写了一行，页是脏的）。所以这一行开库时会先做崩溃恢复——
# stderr 上那句"上次退出时有个没做完的事务"就是它。
#
# 于是这一行把两个阶段接在了一起：
#   · 阶段 5 保证"没提交的改动不会留下"（照日志退回去）
#   · 阶段 6 保证"死掉的进程不会把库锁住"（内核放锁）
# 少任何一个，这一行都跑不出正确结果：前者会让 (2) 留在表里，
# 后者会让它直接报"库被占着"。
-d|test.db|-e|SELECT * FROM t ORDER BY id;

# 恢复做完，日志就没了。
!missing test.db-journal
