# 删掉一堆行之后，同一页里应该还能塞进新行。
#
# 关键在 heapFreeBytes 用的是 cellTop，而删行不动 cellTop：
# 删完看起来还是只剩 36 字节。所以插入必须先把墓碑的字节收回去
# （压缩），才腾得出地方。压缩要是写错了，活着的行会错位或被覆盖。
#
# 算术（都由常量算出来，改了常量注释会跟着变）：
#   一页可用 4096 - 12(页头) = 4084
#   每行 cell = 1+4+74(文本) + 1+8(整数) = 88，加 4 字节槽位 = 92
#   4084 / 92 = 44 行正好填满，只剩 36 字节
#   删掉 id 1..20 之后：剩 24 行活、20 个墓碑
#   压缩后 cellTop = 4096 - 24*88 = 1984
#   可用 = 1984 - (12 + 44*4) = 1796
#          <- 注意槽位数组还是 44 个，不是 24 个
#   槽位数组不会缩：那 20 个墓碑各占 4 字节，永远不回收（见 README）
#   要放进来的行 cell = 400+14 = 414，加槽位 4 = 418
#     418 > 36    -> 不压缩就放不下，压缩一定会被触发
#     418 <= 1796  -> 压缩之后放得下，不该去开新页

-d|test.db|-e|CREATE TABLE d (id INT, s TEXT);
!bulk d|44|74
!pages 3

-d|test.db|-e|DELETE FROM d WHERE id <= 20;
!pages 3

# 这一行只有压缩把墓碑的字节收回去之后才放得下。
# 要是放不下，它会去开新的一页 —— 下面的 !pages 就会说话。
-d|test.db|-e|INSERT INTO d VALUES (900, '');
!pages 3

# 24 行老数据 + 1 行新的 = 25。id 从 21 起（前 20 行删了）。
-d|test.db|-e|SELECT COUNT(*), MIN(id), MAX(id) FROM d;
-d|test.db|-e|SELECT COUNT(*) FROM d WHERE s = 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx';
-d|test.db|-e|SELECT COUNT(*) FROM d WHERE s = '';

# 关掉再打开，压缩后的页得是好的（能读、不崩、数字不变）
-d|test.db|-e|SELECT COUNT(*), SUM(id) FROM d;
-d|test.db|-e|SELECT COUNT(*) FROM d WHERE s = '';
