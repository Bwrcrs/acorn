# 阶段 6：**有人正在写的时候，连读都不行。**
#
# 反过来的那一半。读者被挡住不是因为他要改东西，而是因为
# 他可能读到**改了一半**的状态：那边事务开到一半，缓存里
# 几页是新的、几页是旧的，库文件上还可能躺着回滚日志。
# 这个时候读出来的东西没有意义——它不对应任何一个真实时刻的库。
#
# 【为什么后台那个写者只敲了 BEGIN 就独占】因为升级的时机是
# "事务开始"，不是"第一次写"。理由见 pager.cpp 里
# ensureExclusiveLock 上面那段：一次改动里读和写是混在一起的，
# 等到真要写才升级，中间那段读就是没有锁保护的读。
#
# 所以这一行 BEGIN 看起来什么都没干，但它已经把写的位置占住了。

-d|test.db|-e|CREATE TABLE t (id INT, v TEXT); INSERT INTO t VALUES (1,'one');

# ---- 后台：开一个事务，写一行，然后 2.5 秒不提交 ----
!bg 2500|BEGIN; INSERT INTO t VALUES (2,'two');

# ---- 前台：读。会被拒绝，而且退出码是 2（命令行/环境层面的问题）----
# 这个 2 和"写的时候被拒"那个 2 是同一个数，理由见
# lock_reader_blocks_writer.disk 里那段：脚本靠它分辨
# "过一会儿再来"和"别白费劲了"。
-d|test.db|-e|SELECT * FROM t;

# 写当然更不行。
-d|test.db|-e|INSERT INTO t VALUES (3,'three');

!wait

# ---- 后台那个进程退出了，而它**没有提交** ----
# 所以那一行不该在。这不是阶段 6 的功劳，是阶段 5 的：
# Pager 析构时事务还开着 = 回滚（SQLite 语义）。
# [!wait 抄回来的 stderr 里那句"提醒"就是这件事的凭据。]
-d|test.db|-e|SELECT * FROM t ORDER BY id;
