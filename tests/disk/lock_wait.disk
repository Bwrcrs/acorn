# 阶段 6：--lock-wait=<毫秒>：抢不到锁的时候愿意等多久。
#
# 【为什么默认不等（0 毫秒）】因为一个"静静地卡住"的程序比一个
# 会报错的程序难查得多。愿意等是用户**明确说出来**的事，
# 不能由我们替他猜：猜短了白等，猜长了像死机。
#
# 所以这一条也是设计的一部分：默认行为是"立刻说不行"，
# 而这个开关是"我知道现在有人在用，让我等一下"。

-d|test.db|-e|CREATE TABLE t (id INT, v TEXT); INSERT INTO t VALUES (1,'one');

# ---- 后台：一个读者，占 2 秒 ----
!bg 2000|SELECT * FROM t;

# ---- 前台：想写，愿意等 4 秒 ----
# 读者 2 秒后就走，所以这次会**成功**——等到了。
# 注意这里没有任何"过一会儿再试"的重试代码：等待就在锁那一层，
# 用户看到的就是一条普通的、慢了两秒的 INSERT。
-d|test.db|--lock-wait=4000|-e|INSERT INTO t VALUES (2,'waited');

!wait

# ---- 第二回合：这次等不够 ----
!bg 3000|SELECT * FROM t;

# 后台要 3 秒，这边只肯等 400 毫秒，所以失败。
# 报错里会写明"等了 400 毫秒也没等到"——数字是用户自己给的那个，
# 不然他没法判断是自己等太短还是程序压根没等。
#
# 退出的数是 2（不是 1）："等了还是没轮上"仍然是"环境现在不方便"，
# 不是"这条 SQL 有问题"。脚本据此决定要不要过一会儿再来一次。
-d|test.db|--lock-wait=400|-e|INSERT INTO t VALUES (3,'too late');

!wait

# 数据只该有两条：等到了的那次写进去了，没等到的那次没有。
-d|test.db|-e|SELECT * FROM t ORDER BY id;
