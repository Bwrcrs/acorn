# 阶段 4：一个**存得进表、却装不进索引**的值。
#
# 【这个窗口很窄，但它真实存在，所以必须说清楚】
#   行的大小上限是 4080 字节（MAX_CELL_SIZE，见 page.hpp）
#   键的大小上限是 4070 字节（MAX_KEY_BYTES，见 btree.hpp）
# 键的上限比行小 10 字节，是给"索引项 = 键 + 行号"留放行号的地方。
#
# 单列 TEXT 的表，一个值编码完是 1 字节标签 + 4 字节长度 + N 字节，
# 所以下面这个 N = 4070 的值：
#   当行存：1+4+4070 = 4075 ≤ 4080，放得下
#   当键存：1+4+4070 = 4075 >  4070，放不下
#
# 【真正要钉死的是"失败要失败得干净"】
# CREATE INDEX 在报错之前**不能**留下半棵树、半条目录记录 ——
# 留下了的话，这个库以后每次打开都会去读一棵不存在的树。
# 所以下面报错之后要重开进程再看一眼目录。

-d|test.db|-e|CREATE TABLE big (v TEXT);

# 先插进去。这时候还没有索引，所以没人去量它的键长，插得进。
-d|test.db|-e|INSERT INTO big VALUES ('');
-d|test.db|-e|SELECT COUNT(*) FROM big;

# 现在建索引：这一步要扫全表给每行量一遍键长，
# 量到这个值放不下，就地报错（见 database.cpp 里 createIndex 的第一步）。
-d|test.db|-e|CREATE INDEX big_v ON big (v);

# 报完错，表和目录都得是原样：
# 数据还在，索引一个都没有，那条失败的名字也不能被占住。
-d|test.db|-e|SELECT COUNT(*) FROM big;
stdin:.indexes\n
-d|test.db|-e|DROP INDEX big_v;

# 重开一次再看一眼：确认失败没在文件里留下任何东西
-d|test.db|-e|SELECT COUNT(*) FROM big;
stdin:.indexes\n
stdin:.info\n
