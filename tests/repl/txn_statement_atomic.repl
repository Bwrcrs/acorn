-- 阶段 5：**一条语句自己就是个事务**（自动提交）。
--
-- 【这个用例是阶段 3 欠下的那张条子的收据】
-- 阶段 3 的注释里写着："`UPDATE t SET x = 'abc'` 改到第 3 行报类型错时，
-- 前 2 行已经改了，而且下一次 flush 会把它们一起写出去。"
-- 现在不该是这样了：那条语句要么整条生效，要么整个没生效。
--
-- 【为什么是 .repl 不是 .sql】因为跑脚本文件时一条语句出错会中断
-- 整个文件，那样"出错之后还剩几行"这句 SELECT 根本没机会跑。
-- 而这句 SELECT 正是全部的证明——报错本身不说明任何问题。
--
-- 【怎么才算"证明"】必须让**前几行真的已经写进去了**，再看它们
-- 有没有退回来。所以下面两处都是"前两行没问题、第三行才炸"：
--
--   INSERT：第三个元组 5000 字节，索引键上限是 4070
--   UPDATE：第三行的 a 列 3900 字节，`b = a` 之后整行装不下
--
-- 两处都建了索引，这样"表的数据页"和"B+ 树的页"必须一起退回去。
-- 只退一半的话，索引里就留下指向不存在的行的项——那种坏是不报错的坏。

CREATE TABLE t (id INT, v TEXT);
CREATE INDEX t_v ON t (v);

-- 前两行是好的，第三行  字节
INSERT INTO t VALUES (1, 'a'), (2, 'b'), (3, '');

-- 一行都不该剩：表和索引都退回去了
SELECT COUNT(*) FROM t;

-- 回滚只退到语句开头。下面这三条各自提交，互不影响：
INSERT INTO t VALUES (1, 'a');
INSERT INTO t VALUES (2, 'b');
INSERT INTO t VALUES (3, 'c');
SELECT * FROM t ORDER BY id;

-- ---- UPDATE 同理 ----
CREATE TABLE u (id INT, a TEXT, b TEXT);
CREATE INDEX u_b ON u (b);
INSERT INTO u VALUES (1, 'aaaaaaaaaaaaaaaaaaaa', 'bbbbbbbbbbbbbbbbbbbb');
INSERT INTO u VALUES (2, 'aaaaaaaaaaaaaaaaaaaa', 'bbbbbbbbbbbbbbbbbbbb');
INSERT INTO u VALUES (3, '', 'bbbbbbbbbbbbbbbbbbbb');

-- 第 1、2 行把 b 换成 a 完全没问题（都很短），
-- 第 3 行换完就成了 7800 字节，当场超限。
-- 报错必须发生在第 3 行——所以第 1、2 行**已经改过了**，
-- 这正是"不改回去就会留下半条语句"的场景。
UPDATE u SET b = a;

-- b 还得是原来那串 b。要是这儿印出一串 a，说明回滚没退干净。
SELECT id, b FROM u ORDER BY id;

.quit
